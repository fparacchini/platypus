+                "claude".to_string()
+            } else {
+                s.setting_value
+            }
+        })
+        .unwrap_or_else(|_| "claude".to_string());
+
+    let model_key = match provider.as_str() {
+        "openai" => "model_openai",
+        "gemini" => "model_gemini",
+        "local" => "",
+        _ => "model_claude",
+    };
+
+    let model = if model_key.is_empty() {
+        None
+    } else {
+        app_handle
+            .db(|db| get_setting(db, model_key))
+            .map(|s| {
+                let trimmed = s.setting_value.trim().to_string();
+                if trimmed.is_empty() {
+                    None
+                } else {
+                    Some(trimmed)
+                }
+            })
+            .unwrap_or(None)
+    };
+
+    (provider, model)
+}
